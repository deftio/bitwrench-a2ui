{
  "name": "bitwrench-a2ui",
  "version": "0.9.0",
  "private": false,
  "description": "A2UI v1.0 renderer for plain JavaScript, built on bitwrench. One script tag, live DOM or an HTML string, no framework or build step.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "deftio (https://deftio.com/)",
  "homepage": "https://deftio.github.io/bitwrench-a2ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deftio/bitwrench-a2ui.git"
  },
  "bugs": {
    "url": "https://github.com/deftio/bitwrench-a2ui/issues"
  },
  "keywords": [
    "a2ui",
    "generative-ui",
    "agent-ui",
    "agents",
    "llm",
    "bitwrench",
    "renderer",
    "server-driven-ui",
    "no-build",
    "javascript"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.js",
  "module": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./static": "./src/static/index.js",
    "./transport/jsonl": "./src/transport/jsonl.js",
    "./transport/sse": "./src/transport/sse.js",
    "./transport/websocket": "./src/transport/websocket.js",
    "./transport/a2a": "./src/transport/a2a.js",
    "./transport/agui": "./src/transport/agui.js",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "dist/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "CHANGELOG.md",
    "templates/"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node build.js",
    "test": "node --no-warnings --test \"test/**/*.test.js\"",
    "test:coverage": "c8 --check-coverage --lines 100 --functions 100 --branches 100 --statements 100 --include \"src/**\" --exclude \"src/catalog/basic/catalog-json.js\" --exclude \"src/catalog/basic/icons.js\" --reporter text --reporter lcov node --no-warnings --test \"test/**/*.test.js\"",
    "test:conformance": "node --no-warnings --test test/conformance/conformance.test.js",
    "sync:upstream": "node tools/sync-upstream.js",
    "pages": "node tools/serve.js",
    "spike": "node --no-warnings dev/spike/run.js",
    "test:dist": "node --no-warnings --test \"test/dist/*.test.js\"",
    "site": "node build.js && node tools/build-site.js",
    "conformance:report": "node tools/conformance-report.js",
    "mcp-app": "node templates/mcp-app/build.js",
    "ci": "node tools/ci.js",
    "audit:runtime": "node tools/audit.js",
    "release": "node tools/release.js",
    "release:dry": "node tools/release.js --dry-run",
    "check:package": "node tools/check-package.js",
    "cdn:tags": "node tools/cdn-tags.js",
    "prepublishOnly": "node tools/check-package.js"
  },
  "dependencies": {
    "@a2ui/web_core": "0.15.0",
    "bitwrench": "2.1.15",
    "quikdown": "1.3.2"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "c8": "11.0.0",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "yaml": "2.9.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
